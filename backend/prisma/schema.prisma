// prisma/schema.prisma
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  phoneNo      String   @unique
  dateOfBirth  DateTime @db.Date

  gender     String? @db.VarChar(20)
  bloodGroup String? @db.VarChar(10)
  address    String? @db.Text

  role String @default("USER") @db.VarChar(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments          Appointment[]
  campaignRegistrations CampaignRegistration[]
  donations             Donation[]
  notifications         Notification[]
  bloodUnits            BloodUnit[]
  healthScreenings      HealthScreening[]

  @@map("users")
}

model Hospital {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  passwordHash String
  phoneNo      String  @db.VarChar(20)
  address      String? @db.Text
  isVerified   Boolean

  role String @default("HOSPITAL") @db.VarChar(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments      Appointment[]
  campaigns         Campaign[]
  donations         Donation[]
  notifications     Notification[]
  bloodUnits        BloodUnit[]
  bloodRequests     BloodRequest[]
  sentTransfers     BloodTransfer[] @relation("SourceHospital")
  receivedTransfers BloodTransfer[] @relation("DestinationHospital")

  @@map("hospitals")
}

model Appointment {
  id         String @id @default(uuid())
  userId     String @map("user_id")
  hospitalId String @map("hospital_id")

  appointmentDate DateTime @db.Date
  appointmentTime DateTime @db.Time
  status          String   @db.VarChar(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  donations        Donation[]
  healthScreenings HealthScreening[]

  @@index([userId])
  @@index([hospitalId])
  @@map("appointments")
}

model Campaign {
  id         String @id @default(uuid())
  hospitalId String @map("hospital_id")

  campName     String
  description  String   @db.Text
  address      String   @db.Text
  campaignDate DateTime @db.Date

  startTime DateTime @db.Time
  endTime   DateTime @db.Time

  targetDonors Int
  status       String @db.VarChar(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  campaignRegistrations CampaignRegistration[]

  @@index([hospitalId])
  @@map("campaigns")
}

model CampaignRegistration {
  id         String @id @default(uuid())
  userId     String @map("user_id")
  campaignId String @map("campaign_id")

  status       String   @db.VarChar(30)
  registeredAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  donations Donation[]

  @@unique([userId, campaignId])
  @@index([userId])
  @@index([campaignId])
  @@map("campaign_registrations")
}

model Donation {
  id                     String  @id @default(uuid())
  userId                 String  @map("user_id")
  hospitalId             String  @map("hospital_id")
  appointmentId          String? @unique @map("appointment_id")
  campaignRegistrationId String? @unique @map("campaign_registration_id")

  donationDate DateTime @db.Date
  bloodGroup   String   @db.VarChar(10)
  volume       Int
  status       String   @db.VarChar(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital             Hospital              @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  appointment          Appointment?          @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  campaignRegistration CampaignRegistration? @relation(fields: [campaignRegistrationId], references: [id], onDelete: SetNull)

  bloodUnits BloodUnit[]

  @@index([userId])
  @@index([hospitalId])
  @@map("donations")
}

model Notification {
  id         String  @id @default(uuid())
  userId     String? @map("user_id")
  hospitalId String? @map("hospital_id")

  title   String
  message String @db.Text

  type NotificationType

  priority NotificationPriority

  status NotificationStatus @default(PENDING)

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([hospitalId])
  @@map("notifications")
}

model BloodUnit {
  id         String @id @default(uuid())
  donationId String @map("donation_id")
  donorId    String @map("donor_id")
  hospitalId String @map("hospital_id")

  bloodGroup    String @db.VarChar(10)
  componentType String @db.VarChar(30)

  collectionDate DateTime @db.Date
  expirationDate DateTime @db.Date

  volume          Int
  storageLocation String
  currentStatus   String @db.VarChar(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  donor    User     @relation(fields: [donorId], references: [id], onDelete: Restrict)
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  donation Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)

  bloodTrackingEvents BloodTrackingEvent[]
  verificationLogs    VerificationLog[]
  transfers           TransferBloodUnit[]

  @@index([donationId])
  @@index([donorId])
  @@index([hospitalId])
  @@map("blood_units")
}

model BloodTrackingEvent {
  id          String @id @default(uuid())
  bloodUnitId String @map("blood_unit_id")

  status      String   @db.VarChar(30)
  notes       String   @db.Text
  performedBy String
  timestamp   DateTime

  bloodUnit BloodUnit @relation(fields: [bloodUnitId], references: [id], onDelete: Cascade)

  @@index([bloodUnitId])
  @@map("blood_tracking_events")
}

model VerificationLog {
  id          String @id @default(uuid())
  bloodUnitId String @map("blood_unit_id")

  verifiedBy     String
  previousStatus String   @db.VarChar(30)
  newStatus      String   @db.VarChar(30)
  notes          String   @db.Text
  verifiedAt     DateTime

  bloodUnit BloodUnit @relation(fields: [bloodUnitId], references: [id], onDelete: Cascade)

  @@index([bloodUnitId])
  @@map("verification_logs")
}

model BloodRequest {
  id                   String @id @default(uuid())
  requestingHospitalId String @map("requesting_hospital_id")

  bloodGroup    String @db.VarChar(10)
  unitsRequired Int
  priority      String @db.VarChar(20)
  reason        String @db.Text
  status        String @db.VarChar(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requestingHospital Hospital        @relation(fields: [requestingHospitalId], references: [id], onDelete: Cascade)
  transfers          BloodTransfer[]

  @@index([requestingHospitalId])
  @@map("blood_requests")
}

model BloodTransfer {
  id                    String         @id @default(uuid())
  requestId             String         @map("request_id")
  sourceHospitalId      String         @map("source_hospital_id")
  destinationHospitalId String         @map("destination_hospital_id")
  unitsTransferred      Int
  status                TransferStatus
  dispatchedAt          DateTime?
  receivedAt            DateTime?
  completedAt           DateTime?
  notes                 String?        @db.Text
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  bloodRequest        BloodRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sourceHospital      Hospital            @relation("SourceHospital", fields: [sourceHospitalId], references: [id], onDelete: Restrict)
  destinationHospital Hospital            @relation("DestinationHospital", fields: [destinationHospitalId], references: [id], onDelete: Restrict)
  bloodUnits          TransferBloodUnit[]

  @@index([requestId])
  @@index([sourceHospitalId])
  @@index([destinationHospitalId])
  @@map("blood_transfers")
}

model TransferBloodUnit {
  id          String @id @default(uuid())
  transferId  String @map("transfer_id")
  bloodUnitId String @map("blood_unit_id")

  transfer  BloodTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  bloodUnit BloodUnit     @relation(fields: [bloodUnitId], references: [id], onDelete: Cascade)

  @@unique([transferId, bloodUnitId])
  @@map("transfer_blood_units")
}

model HealthScreening {
  id            String  @id @default(uuid())
  userId        String  @map("user_id")
  appointmentId String? @map("appointment_id")

  hasFever         Boolean
  takingMedication Boolean

  recentTatto      Boolean
  tattooDate       DateTime?

  recentSurgery    Boolean
  surgeryDate      DateTime? @db.Date
  pregnant         Boolean

  weight        Int
  travelHistory Boolean
  eligible      Boolean
  screenedAt    DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

enum TransferStatus {
  PENDING
  DISPATCHED
  RECEIVED
  COMPLETED
  CANCELLED
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum NotificationType {
  APPOINTMENT_BOOKED
  APPOINTMENT_CANCELLED
  APPOINTMENT_REMINDER

  CAMPAIGN_REGISTERED
  CAMPAIGN_REMINDER

  DONATION_COMPLETED
  CERTIFICATE_READY

  ELIGIBLE_AGAIN

  ACHIEVEMENT_UNLOCKED

  EMERGENCY_REQUEST

  BLOOD_REQUEST_APPROVED
  BLOOD_REQUEST_REJECTED

  TRANSFER_DISPATCHED
  TRANSFER_RECEIVED
  TRANSFER_COMPLETED

  SYSTEM
}
