// prisma/schema.prisma
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id    String @id @default(uuid())
  name  String
  email String @unique
  passwordHash String
  phoneNo String @unique
  dateOfBirth DateTime

  gender String?
  bloodGroup String?
  address String?
  

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
